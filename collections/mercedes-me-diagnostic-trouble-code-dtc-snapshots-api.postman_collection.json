      "description": {
        "content": "Remote Diagnostic Support service for view dtc snapshot List.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b6b1105c-4f04-452e-82a9-e65197406f83",
          "name": "View the List of Dtc Snapshot for Specific vehicleId",
          "request": {
            "name": "View the List of Dtc Snapshot for Specific vehicleId",
            "description": {
              "content": "This API creates a readout of a DTC snapshot from one vehicle. If the result is available immediately, the result is returned. If the result isn't available, a location to the DTC snapshot readout is returned. This location shall be polled until the result is available. INFO: GET Requests are not yet supported!",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vehicles",
                ":vehicleId",
                "ecuId",
                ":ecuId",
                "dtcId",
                ":dtcId",
                "dtcSnapshotReadouts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vehicleId",
                  "description": "(Required) The vehicle identifier of the vehicle to read from"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ecuId",
                  "description": "(Required) The id of the ECU to read from"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "dtcId",
                  "description": "(Required) The id of the DTC associated with the snapshot"
                }
              ]
