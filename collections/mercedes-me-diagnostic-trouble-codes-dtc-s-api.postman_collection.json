  "info": {
    "_postman_id": "7fce8c7e-e6ce-4db2-9b96-906dd5839f1e",
    "name": "Car Configurator Components Diagnostic Trouble Codes (DTC's) API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Car Configurator API offers access to the Mercedes-Benz car configuration functions. It provides required reference data such as the masterdata of all Mercedes-Benz vehicles as well as functions to retrieve initial and changed configurations. In addition to that is is possible to save a newly created configuration so that it can be easily restored or shared with others.\n\nContact Support:\n Name: The open API platform by Mercedes-Benz",
      "type": "text/plain"
    }
  }
