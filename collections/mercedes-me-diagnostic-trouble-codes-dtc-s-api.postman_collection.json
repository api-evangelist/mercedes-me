  "item": [
    {
      "id": "28d80d9c-6b91-45ac-89c9-4c669661f136",
      "name": "Diagnostic Trouble Codes (DTC's)",
      "description": {
        "content": "Remote Diagnostic Support service for view dtc List.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "cb01f28c-bdde-45e0-8046-68ce7ffc57e2",
          "name": "View the List of Dtcs for Specific vehicleId",
          "request": {
            "name": "View the List of Dtcs for Specific vehicleId",
            "description": {
              "content": "This API creates a readout of DTCs for one vehicle. If the result is available immediately, the result is returned. If the result isn't available, a location to the DTC readout is returned. This location shall be polled until the result is available. INFO: GET Requests are not yet supported!",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vehicles",
                ":vehicleId",
                "dtcReadouts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ecuId",
                  "value": "<string>",
                  "description": "Return DTCs from this ECU id only. Default: Return DTCs from all ECUs."
                },
                {
                  "disabled": false,
                  "key": "dtcStatus",
                  "value": "<string>",
                  "description": "Returns DTCs with this statuses only. Default: Return DTCs with all statuses."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vehicleId",
                  "description": "(Required) The vehicle identifier of the vehicle to read from."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/x.exve.org.dtcreadout.v1+json;charset=utf-8"
              }
            ],
            "method": "POST",
            "auth": null
          },
