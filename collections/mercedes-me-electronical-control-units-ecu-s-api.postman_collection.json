          "id": "f678c083-f815-44ba-935e-bcf1be29e5dd",
          "name": "View the List of Ecu for Specific vehicleId",
          "request": {
            "name": "View the List of Ecu for Specific vehicleId",
            "description": {
              "content": "This API creates a readout of ECUs for one vehicle. If the result is available immediately, the result is returned. If the result isn't available, a location to the ECU readout is returned. This location shall be polled until the result is available. INFO: GET Requests are not yet supported!",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "vehicles",
                ":vehicleId",
                "ecuReadouts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ecuId",
                  "value": "<string>",
                  "description": "Return this ECU id only. Default: Return all ECUs."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "vehicleId",
                  "description": "(Required) The vehicle identifier of the vehicle to read from"
                }
              ]
